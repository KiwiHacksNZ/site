---
import ForkPreviewPage from '../ForkPreviewPage/ForkPreviewPage.jsx';
import { SpeedInsights } from "@vercel/speed-insights/react";
import { Analytics } from "@vercel/analytics/react";
import { seoHeadHtml } from "../SEO/seoConfig.js";
import '../index.css';
import '../App/App.css';

const { title = "KiwiHacks", isSeoEnabled = import.meta.env.VITE_SEO === "true" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    {isSeoEnabled ? (
      <Fragment set:html={seoHeadHtml} />
    ) : (
      <>
        <title>KiwiHacks Fork Preview</title>
        <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,max-image-preview:none" />
      </>
    )}
  </head>
  <body>
    <SpeedInsights client:idle />
    <Analytics client:idle />
    {isSeoEnabled ? (
      <slot />
    ) : (
      <ForkPreviewPage client:load>
        <slot />
      </ForkPreviewPage>
    )}
  </body>
</html>
