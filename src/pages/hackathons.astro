---
import Layout from '../layouts/Layout.astro';
import Hackathons from '../Hackathons/Hackathons.jsx';
import { LISTINGS } from '../Hackathons/listings.js';

// MVP: listings are hardcoded in src/Hackathons/listings.js. They move to
// Sanity (src/sanity/schema.js, "hackathon" type) once the design is agreed.

// Today's date in New Zealand as YYYY-MM-DD. Listings store plain dates, so an
// event stays up for the whole of its last day here rather than dropping off
// at midnight UTC (midday in NZ). The page renders per request, so a finished
// event moves to "Past events" the next day without a redeploy.
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Pacific/Auckland',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());

const listings = LISTINGS.map(({ banner, logo, ...listing }) => ({
  ...listing,
  endDate: listing.endDate ?? listing.startDate,
  format: listing.format === 'online' ? 'online' : 'in-person',
  featured: Boolean(listing.featured),
  url: listing.url ?? null,
  time: listing.time ?? null,
  logoUrl: logo ?? null,
  bannerUrl: banner ?? null,
})).sort((a, b) => a.startDate.localeCompare(b.startDate) || a.name.localeCompare(b.name));

// Plain YYYY-MM-DD strings compare correctly as text.
const upcoming = listings.filter((listing) => listing.endDate >= today);
const past = listings
  .filter((listing) => listing.endDate < today)
  .reverse()
  .map((listing) => ({ ...listing, featured: false }));
---

<Layout title="Upcoming High School Hackathons in New Zealand | KiwiHacks">
  <Hackathons client:load listings={upcoming} pastListings={past} currentYear={Number(today.slice(0, 4))} />
</Layout>
